# Required. The account that deploys, claims, refutes and pays for gas.
# Never commit the real file — .env is gitignored.
PRIVATE_KEY=0x...

# Creditcoin CC3 Testnet, chain id 102031.
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Source chains. `*_RPC` is the primary; `*_RPCS` replaces the bundled list of
# independent endpoints, `*_RPCS_EXTRA` adds to it. Sealing a claim needs two
# endpoints that answer — run `npm run doctor` before staking a bond.
MAINNET_RPC=https://gateway.tenderly.co/public/mainnet
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# MAINNET_RPCS=https://a.example,https://b.example
# MAINNET_RPCS_EXTRA=https://your-paid-endpoint.example
# SEPOLIA_RPCS_EXTRA=

# Lender policy, read at deploy time and recorded in deployments.json.
# MIN_CHALLENGE_WINDOW=25
# VOLUME_UNIT_IN_CTC=15000000000000
# MIN_HISTORY_BLOCKS=216000
# MAX_STALENESS_BLOCKS=50400
# REPAYMENT_BPS=10500
# REPAY_WINDOW_BLOCKS=5760
# LENDER_MAINNET=0x28C6c06298d514Db089934071355E5743bf21d60

# Timeouts and budgets.
# SOURCE_TIMEOUT_MS=25000
# PROVER_TIMEOUT_MS=30000
# WAIT_ATTESTED_MS=900000

# Per-script knobs. The README's configuration table lists all of them.
# CONTROL_CHAIN_KEY=1
# RESUME_SCAN=200
# FORCE_MODELLED_GAS=
# ALLOW_SINGLE_SOURCE=
