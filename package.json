{
  "name": "utuh",
  "version": "0.1.0",
  "description": "A completeness layer for the Attestcoin Protocol, and undercollateralized credit built on it.",
  "private": true,
  "license": "MIT",
  "author": "Pugar Huda Mantoro",
  "keywords": [
    "creditcoin",
    "attestcoin",
    "undercollateralized-credit",
    "solidity",
    "foundry"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "forge build",
    "deploy": "tsx offchain/deploy.ts",
    "redeploy:credit": "tsx offchain/redeployCredit.ts",
    "e2e": "tsx offchain/e2e.ts",
    "credit": "tsx offchain/creditDemo.ts",
    "cure": "tsx offchain/cureDemo.ts",
    "balance": "tsx offchain/balance.ts",
    "typecheck": "tsc --noEmit",
    "test": "forge test",
    "probe": "tsx offchain/probe.ts",
    "demo": "npm run e2e && npm run credit",
    "control": "tsx offchain/proveControl.ts",
    "full": "tsx offchain/fullFlow.ts",
    "finish": "tsx offchain/finishLine.ts",
    "watch": "tsx offchain/watch.ts",
    "mcp": "tsx offchain/mcp.ts",
    "bait": "tsx offchain/badClaim.ts",
    "livetest": "tsx offchain/liveTest.ts",
    "doctor": "tsx offchain/doctor.ts",
    "verify": "tsx offchain/verify.ts",
    "provers": "tsx offchain/provers.ts",
    "slither": "slither .",
    "fmt": "forge fmt",
    "check": "forge fmt --check && forge lint src/ && forge test && prettier --check \"offchain/**/*.ts\" \"web/**/*.ts\" && tsc --noEmit -p tsconfig.json && slither .",
    "gas": "tsx offchain/gas.ts",
    "web:build": "esbuild web/main.ts --bundle --format=esm --target=es2022 --minify --outfile=web/dist/main.js",
    "web": "npm run web:build && npm run web:static && tsx web/serve.ts",
    "web:static": "tsx web/build-static.ts",
    "web:pdf": "tsx web/build-pdf.ts",
    "web:test": "playwright test",
    "web:shots": "tsx web/tests/shots.ts",
    "lint": "forge lint src/",
    "format": "prettier --write \"offchain/**/*.ts\" \"web/**/*.ts\"",
    "format:check": "prettier --check \"offchain/**/*.ts\" \"web/**/*.ts\"",
    "deadcode": "knip",
    "symbolic": "npm run symbolic:build && halmos --forge-build-out out-halmos --contract EventScopeKeySymbolic",
    "symbolic:deep": "npm run symbolic:build && halmos --forge-build-out out-halmos --contract CreditRoundingSymbolic --solver-timeout-assertion 600000",
    "symbolic:build": "forge build --no-dynamic-test-linking --ast --out out-halmos",
    "mcp:package": "tsx offchain/build-mcp.ts"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "^0.1.2",
    "@gluwa/usc-sdk": "^0.18.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
