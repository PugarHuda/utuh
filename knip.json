{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "offchain/*.ts",
    "web/*.ts"
  ],
  "project": [
    "offchain/**/*.ts",
    "web/**/*.ts"
  ],
  "ignoreBinaries": [
    "forge",
    "slither",
    "halmos"
  ],
  "ignoreDependencies": [
    "@gluwa/usc-contracts"
  ],
  "ignoreExportsUsedInFile": true
}
